{
  "name": "piweave",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript orchestrator that coordinates isolated Pi SDK roles.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --project tsconfig.check.json",
    "test": "node --import tsx --test tests/orchestration.test.ts tests/executor.test.ts tests/cli.test.ts",
    "build": "tsc --project tsconfig.json",
    "dev": "tsx src/orchestration/cli.ts",
    "start": "node dist/cli.js",
    "verify:sdk": "tsx scripts/verify-sdk.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
